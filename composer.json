{
    "name": "harington/secure-api",
    "description": "API PHP d'exemple pour le lab DevSecOps (volontairement vulnérable)",
    "type": "project",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "7.4.0",
        "monolog/monolog": "2.3.0",
        "twig/twig": "3.3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "config": {
        "optimize-autoloader": false,
        "platform": {
            "php": "8.1.0"
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
